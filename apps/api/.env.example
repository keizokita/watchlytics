DATABASE_URL=postgres://dev:dev@localhost:5433/watchlytics

# C1 — shim de autenticação, some no merge de C2 (Google OAuth).
# O seed cria este usuário quando a variável está definida.
# NUNCA definir em produção: sem ela, toda rota autenticada responde 401.
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# C3 — chave do HMAC do JWT de acesso. Mínimo 32 caracteres.
# Trocar invalida todo access token em circulação (o refresh continua valendo).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-nao-use-em-producao-troque-esta-chave

# C2 — credenciais do cliente OAuth "Web application" do Google Cloud Console.
# O client_secret fica SÓ aqui: a troca do código nunca acontece no browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowlist, separada por vírgula. Precisa bater byte a byte com o que o cliente
# usa na autorização e com o que está registrado no Google Cloud Console.
GOOGLE_REDIRECT_URIS=http://localhost:5173/
